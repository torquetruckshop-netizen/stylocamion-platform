# Stylo Cargas MVP
# Copiar a variables seguras del entorno. No subir valores reales al repositorio.

PORT=8787
STAGING_PORT=8788

# Orígenes web autorizados para usar cookies de sesión con el API de staging.
# Separar varios por coma. Ej.: https://cargas-staging.stylocamion.com
STAGING_ALLOWED_ORIGINS=

# Administración
ADMIN_API_KEY=

# Google Identity Services (OPCIONAL: el acceso base de Stylo no depende de Google)
GOOGLE_CLIENT_ID=

# Supabase / persistencia de staging
SUPABASE_URL=
# Preferir la nueva secret key de servidor. Si el proyecto usa claves legacy, se admite SERVICE_ROLE.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business Platform (opcional hasta conectar el canal real)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DISPLAY_NUMBER=

# OpenAI (opcional hasta activar transcripción/IA real)
OPENAI_API_KEY=
OPENAI_MODEL=

# Sesión persistente: la actividad renueva silenciosamente el vencimiento.
SESSION_IDLE_DAYS=365

# Configuración operativa
STYLO_AUTONOMY_MODE=ASSISTED
STYLO_MATCH_MIN_SCORE=90
STYLO_INITIAL_RADIUS_KM=50
STYLO_MAX_RADIUS_KM=300
STYLO_PLATFORM_FEE_PERCENT=3

# Distancias: mientras no haya proveedor vial, Stylo usa estimación explícita
# sobre línea recta sólo con ubicación reciente y la marca como confianza MEDIUM.
STYLO_ESTIMATED_ROAD_MULTIPLIER=1.18
VEHICLE_LOCATION_STALE_MINUTES=240

# Telemetría
# Las credenciales reales de Wialon/Navixy/u otro proveedor NO van aquí en el repo.
# telematics_connections.secret_reference debe apuntar a un secreto seguro del backend.
